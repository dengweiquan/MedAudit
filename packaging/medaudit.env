# MedAudit 服务端环境。修改后执行：systemctl restart medaudit-server
MEDAUDIT_PLATFORM_DB=/var/lib/medaudit/medaudit.db
MEDAUDIT_COLLECTOR_BIN=/opt/medaudit/bin/medaudit-collector
MEDAUDIT_COLLECTOR_WIN_BIN=/opt/medaudit/bin/medaudit-collector.exe
MEDAUDIT_DISPLAY_TZ=Asia/Shanghai
# 复检周期（天）：工作台「该复检了」按此提醒逾期/即将到期的对象，缺省 30
#MEDAUDIT_AUDIT_CYCLE_DAYS=30
# 本站医院（单院部署：安装时交互询问填写，或事后改此文件并重启服务；留空为多院/维护模式）
MEDAUDIT_SITE_HOSPITAL_ID=
MEDAUDIT_SITE_HOSPITAL_NAME=
# 证据加密密钥：首次安装自动生成。请与平台库一同备份——丢失则历史证据不可读。
MEDAUDIT_EVIDENCE_KEY=
MEDAUDIT_EVIDENCE_KEY_VERSION=1
# 授权版构建的许可证文件路径（缺省 /etc/medaudit/medaudit.license）；免费版忽略此项。
#MEDAUDIT_LICENSE=/etc/medaudit/medaudit.license
